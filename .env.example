# Compose host paths. The mounted TOML paths must match the container paths
# in config/libraries.toml.
MOTH_CONFIG_PATH=./config/libraries.toml
MOTH_NOVELS_PATH=./books/novels
MOTH_COMICS_PATH=./books/comics

# If MOTH_CONFIG_FILE is omitted from a custom deployment, MOTH_BOOKS_DIR is
# used as key=default, name=书库. Compose uses the explicit TOML file above.
MOTH_COOKIE_SECURE=false
MOTH_SESSION_TTL_DAYS=30
MOTH_LOG=info

# Optional credentials for scripts/setup-local.ps1 only. The server never
# reads these variables or logs them.
MOTH_TEST_USERNAME=moth-test
MOTH_TEST_PASSWORD=replace-with-at-least-10-characters
