# Host path mounted read-only at /books by compose.yaml.
MOTH_BOOKS_PATH=./books

# Keep false for local HTTP. Set true when HTTPS is terminated by a reverse proxy.
MOTH_COOKIE_SECURE=false
MOTH_SESSION_TTL_DAYS=30
MOTH_LOG=info

# Optional credentials for the explicit local setup helper below.
# The Moth server does not read these variables and never logs them.
# Copy this file to .env before editing; keep real credentials out of git.
MOTH_TEST_USERNAME=moth-test
MOTH_TEST_PASSWORD=replace-with-at-least-10-characters
